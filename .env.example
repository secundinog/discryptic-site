# Mailgun — contact form (set these in Vercel → Project → Settings → Environment Variables)

# Private API key from Mailgun → Settings → API Keys
MAILGUN_API_KEY=

# Sending domain verified in Mailgun, e.g. mg.example.com
MAILGUN_DOMAIN=

# Where contact form submissions are delivered
CONTACT_EMAIL_TO=

# Optional — only for EU-region Mailgun accounts
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Optional — sender shown on the email; defaults to "Discryptic Website <postmaster@MAILGUN_DOMAIN>"
# MAILGUN_FROM=Discryptic Website <noreply@mg.example.com>
